    <ClCompile Include="$(VorbisDir)lib\res0.c" />
    <ClCompile Include="$(VorbisDir)lib\sharedbook.c" />
    <ClCompile Include="$(VorbisDir)lib\smallft.c" />
    <ClCompile Include="$(VorbisDir)lib\synthesis.c" />
    <ClCompile Include="$(VorbisDir)lib\vorbisenc.c" />
    <ClCompile Include="$(VorbisDir)lib\vorbisfile.c" />
    <ClCompile Include="$(VorbisDir)lib\window.c" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
